<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="#0D0D1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RedGif Board"
        android:textSize="30sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GIF Keyboard · Powered by RedGifs"
        android:textSize="12sp"
        android:textColor="#E94560"
        android:layout_marginBottom="40dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STEP 1"
        android:textSize="10sp"
        android:textColor="#666680"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btnEnable"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Enable Keyboard in Settings"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E94560"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/step2Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap Step 1 first to enable the keyboard."
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginBottom="28dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STEP 2"
        android:textSize="10sp"
        android:textColor="#666680"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btnSelect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Switch to RedGif Board"
        android:textColor="#FFFFFF"
        android:backgroundTint="#16213E" />

</LinearLayout>
